# ==============================================================================
# Server Configuration
# ==============================================================================

# The port number on which the HTTP server listens for incoming connections.
# Default: 3000
PORT=

# The operational environment for the application.
# Controls performance optimizations, debug logs, and error stack trace visibility.
# Options: production | development | test
# Default: production
NODE_ENV=

# ==============================================================================
# Database Configuration
# ==============================================================================

# PostgreSQL database connection URI used by Drizzle ORM and the pg connection pool.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
#
# Examples:
# - Local (Host): postgresql://postgres:postgres@localhost:5432/forkit_db
# - Local (Docker): postgresql://postgres:postgres@db:5432/forkit_db
DATABASE_URL=

# ==============================================================================
# Secret Configuration
# ==============================================================================

# Secret key used to sign and verify JSON Web Tokens (JWTs) for session authentication.
# Must be a long, random, unpredictable string — treat it like a password.
# Never commit the real value or reuse it across environments.
# 
# Generate one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
